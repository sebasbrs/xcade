---
import type { Game } from '../lib/games';

interface Props {
    game: Game;
}

const { game } = Astro.props;
const tags = game.tags.split(',').map((tag) => tag.trim()).filter(Boolean).slice(0, 8);
---
<section class="game-info-card" aria-labelledby="game-info-title">
    <div>
        <p class="eyebrow">Game Info</p>
        <h2 id="game-info-title">About {game.title}</h2>
        <p>{game.description}</p>
    </div>

    <div class="game-info-card__grid">
        <div>
            <span>Category</span>
            <strong>{game.category}</strong>
        </div>
        {game.width > 0 && game.height > 0 && (
            <div>
                <span>Game Size</span>
                <strong>{game.width} x {game.height}</strong>
            </div>
        )}
    </div>

    <div>
        <h3>How to play</h3>
        <p>{game.instructions}</p>
    </div>

    {tags.length > 0 && (
        <ul class="tag-list" aria-label="Game tags">
            {tags.map((tag) => <li>{tag}</li>)}
        </ul>
    )}
</section>
